# doc/algebra.xml:59-74
gap> A1 := GroupRing( GF(5), Group( (1,2,3,4,5,6) ) );;
gap> SetName( A1, "A1" );
gap> BA1 := BasisVectors( Basis( A1 ) );; 
gap> v := BA1[1] + BA1[3] + BA1[5];
